# Configuration backend pour la production (utilisée par docker-compose.prod.yml).
# Copiez ce fichier vers server/.env.production puis remplissez de vraies valeurs :
#   cp server/.env.production.example server/.env.production

# Valeur indicative : docker-compose.prod.yml la surcharge automatiquement
# pour pointer vers le conteneur "db" (voir POSTGRES_* dans .env.prod).
DATABASE_URL="postgresql://postgres:postgres@db:5432/pilotmanager?schema=public"

PORT=4000
NODE_ENV=production

# Auth — générez une valeur aléatoire forte, par exemple :
#   openssl rand -base64 48
JWT_SECRET="change-cette-valeur-en-production"
JWT_EXPIRES_IN="7d"

# URL publique du frontend (CORS). Remplacez par votre IP + le port choisi
# dans .env.prod (CLIENT_PORT), ou par votre nom de domaine une fois configuré.
CLIENT_URL="http://VOTRE_IP:8080"

# Email — SMTP_HOST et SMTP_PORT sont surchargés par docker-compose.prod.yml pour
# pointer vers le conteneur MailCatcher (emails capturés, jamais délivrés).
SMTP_FROM="no-reply@pilotmanager.local"