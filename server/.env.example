# Base de données PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pilotmanager?schema=public"

# Serveur
PORT=4000
NODE_ENV=development

# Auth
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# CORS
CLIENT_URL="http://localhost:5173"

# Email (dev : MailCatcher, cf. docker-compose.yml — interface web sur http://localhost:1080)
SMTP_HOST="mailcatcher"
SMTP_PORT=1025
SMTP_FROM="no-reply@pilotmanager.local"
