# Image de production pour le backend : build TypeScript, puis image
# runtime allégée (pas de devDependencies, pas de code source).

# ---- Stage 1 : build ----
FROM node:22-alpine AS build

RUN apk add --no-cache libc6-compat openssl

WORKDIR /repo

# On copie uniquement les manifests d'abord pour profiter du cache Docker
# tant que les dépendances ne changent pas.
COPY package.json package-lock.json ./
COPY server/package.json server/package.json
COPY client/package.json client/package.json
RUN npm ci

COPY server server
WORKDIR /repo/server
RUN npx prisma generate
RUN npm run build

# Supprime les devDependencies (typescript, ts-node, @types/*...) devenues
# inutiles maintenant que le build est fait.
WORKDIR /repo
RUN npm prune --omit=dev

# ---- Stage 2 : runtime ----
FROM node:22-alpine

RUN apk add --no-cache openssl

ENV NODE_ENV=production
WORKDIR /repo/server

COPY --from=build /repo/node_modules /repo/node_modules
# node_modules propre au workspace "server" (versions qui divergent de
# celles hoistées à la racine, ex. typescript req. par le client en v6+).
COPY --from=build /repo/server/node_modules ./node_modules
COPY --from=build /repo/server/dist ./dist
COPY --from=build /repo/server/package.json ./package.json
COPY --from=build /repo/server/tsconfig.json ./tsconfig.json
COPY --from=build /repo/server/prisma ./prisma

EXPOSE 4000

# Applique les migrations Prisma en attente puis démarre le serveur.
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/index.js"]