# Variables utilisées par docker-compose.prod.yml (à la racine du serveur IONOS).
# Copiez ce fichier vers .env.prod puis remplissez de vraies valeurs :
#   cp .env.prod.example .env.prod

POSTGRES_USER=pilotmanager
POSTGRES_PASSWORD=change-moi-mot-de-passe-fort
POSTGRES_DB=pilotmanager

# Port exposé sur l'hôte pour accéder au site : http://VOTRE_IP:CLIENT_PORT
CLIENT_PORT=8080